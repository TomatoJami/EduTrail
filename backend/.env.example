# Backend Environment Variables
# Copy this file to .env.local and fill in your actual values

# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&appName=EduTrail

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# JWT secret used to sign one-hour auth tokens
JWT_SECRET=change_me_to_a_long_random_secret

# CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# Enable Swagger UI in production only when explicitly needed
ENABLE_API_DOCS=false

# Frontend URL used to generate password reset links
FRONTEND_URL=http://localhost:3000

# Default admin user created on backend startup when it does not exist
DEFAULT_ADMIN_EMAIL=admin@edutrail.local
DEFAULT_ADMIN_PASSWORD=12345678A!

# SMTP configuration for password reset emails
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# Outlook example: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
MAIL_FROM="EduTrail <your_email@gmail.com>"

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

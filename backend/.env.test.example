# Backend E2E test environment
# Copy this file to backend/.env.test and fill in values for a TEST database only.

# Use a separate MongoDB database or cluster for E2E tests.
# The seed script clears collections before inserting fresh test data.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/edutrail_test?retryWrites=true&w=majority&appName=EduTrailTest

# Backend test server port. Keep this in sync with E2E_BACKEND_PORT if you override it.
PORT=5000

# Test mode makes backend/src/config/env.ts load backend/.env.test.
NODE_ENV=test

# JWT secret used by the backend during tests.
JWT_SECRET=change_me_to_a_long_random_test_secret

# Frontend origin used by CORS and password-reset links during E2E.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Seeded admin account used by E2E tests.
DEFAULT_ADMIN_EMAIL=admin@test.com
DEFAULT_ADMIN_PASSWORD=12345678A!

# Seeded learner account used by E2E tests.
E2E_USER_EMAIL=student@test.com
E2E_USER_PASSWORD=12345678A!

# Safety flag for manual seeding only.
# npm run seed:e2e sets this automatically. Do not enable it for a real database.
ALLOW_E2E_DB_RESET=false

# Optional. Only needed if you test uploads or email-related flows.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
MAIL_FROM="EduTrail Test <your_email@gmail.com>"
